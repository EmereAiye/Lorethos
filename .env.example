# ==============================================================================
# Lorethos Environment Variables Template
# Copy to `.env` for local development or configure under:
# Vercel Project -> Settings -> Environment Variables (Preview & Production)
# Never commit real API keys or database credentials to GitHub.
# ==============================================================================

# REQUIRED FOR AI TEXT, TTS NARRATION & TRANSCRIPTION (Gemini)
GEMINI_API_KEY=""

# REQUIRED FOR AI VIDEO TRAILER GENERATION (WaveSpeedAI)
WAVESPEED_API_KEY=""
# Optional overrides (defaults to alibaba/wan-3.0/text-to-video for 15-30s audio trailers)
# WAVESPEED_VIDEO_MODEL="alibaba/wan-3.0/text-to-video"
# WAVESPEED_VIDEO_RESOLUTION="480p"

# REQUIRED FOR AUTH & ADMIN OWNER ROLE
SESSION_SECRET="change_me_to_long_random_hex_string"
OWNER_EMAIL="Emmymasterwise@gmail.com"

# DATABASE (Set DATABASE_URL on Vercel for persistent Postgres; optional in local dev)
DATABASE_URL=""

# SUPABASE CLIENT (Optional; ensure URL has no trailing bracket)
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"

# OPTIONAL ON VERCEL PREVIEW (Leave blank for previews; Vercel uses the active preview host automatically)
APP_URL=""
SITE_DOMAIN=":80"

# OPTIONAL FOR HOSTED PAYSTACK CHECKOUT
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# OPTIONAL FOR DOCKER COMPOSE POSTGRES ONLY
POSTGRES_USER="lorethos"
POSTGRES_PASSWORD="change_me_postgres_password"
POSTGRES_DB="lorethos"
