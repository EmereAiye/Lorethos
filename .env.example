# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=""

# APP_URL / SITE_DOMAIN: Public application origin & Caddy site domain
APP_URL="http://localhost:3000"
SITE_DOMAIN=":80"

# DATABASE: PostgreSQL connection string (leave blank in dev for local file fallback)
DATABASE_URL=""
POSTGRES_USER="lorethos"
POSTGRES_PASSWORD="change_me_postgres_password"
POSTGRES_DB="lorethos"

# AUTH & OWNER ROLE: Server session signing secret and designated publisher email
SESSION_SECRET="change_me_to_long_random_hex_string"
OWNER_EMAIL="Emmymasterwise@gmail.com"

# PAYSTACK: Server-side secret and webhook verification key (never expose to browser)
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""

# OPTIONAL SUPABASE CLIENT CONFIG
VITE_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY"
